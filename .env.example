# Obtém API_ID e API_HASH em https://my.telegram.org  (API development tools)
API_ID=
API_HASH=
# Cria o bot de controlo no @BotFather e cola aqui o token
BOT_TOKEN=

# web     = sem conta: lê canais PÚBLICOS pela web e publica com o bot (por omissão)
# account = com a tua conta (lê grupos privados, emojis premium); exige "botctl login"
MODE=web

# O teu ID numérico de Telegram (fala com o @userinfobot). Obrigatório no modo web.
OWNER_ID=

# Código de desconto inicial (muda-se depois com /codigo no Telegram)
DEFAULT_CODE=

# Limites e comportamento
MAX_PER_HOUR=12
MIN_INTERVAL_SEC=20
DEDUP_HOURS=24
IDLE_ALERT_HOURS=12
REQUIRE_PHOTO=true
WEB_POLL_SEC=120
